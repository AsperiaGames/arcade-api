# Copy to .env for local development. Never commit the real file.
# Every variable is read once at startup; a bad value fails the boot loudly
# rather than surfacing on some request path later.

PORT=8080

# --- Database ----------------------------------------------------------------
# Local development (see docker-compose.yml):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arcade
#
# On Neon, prefer the DIRECT endpoint over the pooled one. The pooler runs
# PgBouncer in transaction mode, which breaks pgx's default extended protocol
# with prepared statements — and this service runs on long-lived machines where
# pgxpool already pools connections, so the pooler buys nothing.
# Co-locate the Neon region with the Fly region; a cross-region round trip on
# every ledger transaction is a real cost.

# --- Auth --------------------------------------------------------------------
# The Storm-Gate OIDC issuer. Its published JWKS verifies RS256 tokens locally —
# there is deliberately no shared signing secret here, which is what lets this
# service be written in a different language from the issuer.
# Production:
#   STORM_GATE_URL=https://3ynqb3302m.execute-api.us-east-1.amazonaws.com
STORM_GATE_URL=https://storm-gate.example.com

# Authenticates trusted backends on /internal (blog-portfolio credits points
# after a PayPal capture, and holds points for store and AI-art purchases).
# A player JWT is never accepted there. Must be at least 32 characters; the
# service refuses to start otherwise, because an empty value would silently
# admit everyone.
#   openssl rand -base64 48
SERVICE_TOKEN=replace-with-a-long-random-secret-at-least-32-chars

# --- CORS --------------------------------------------------------------------
# Browser origins allowed to call /api directly. The arcade is a separate origin,
# so this is load-bearing rather than decorative. An unlisted origin receives no
# CORS headers and the browser blocks it.
# Production includes:
#   https://asperiagames.com,https://www.asperiagames.com,https://hoseacodes.com
CORS_ORIGINS=http://localhost:4321,http://localhost:3000

# --- Abuse limits ------------------------------------------------------------
# /api/points/earn takes a client-supplied amount from a browser, and Storm-Gate
# issues guest tokens to anyone unauthenticated, so both ceilings matter.
#
# Largest single earn (one game-over). The arcade client caps itself at 500, so
# this is the backstop against a forged request.
POINTS_MAX_SINGLE_EARN=10000
# Total per user per UTC day. Exceeding it returns HTTP 429, which the arcade
# client already understands as `daily-cap`. Must be >= the single-call cap.
POINTS_MAX_DAILY_EARN=10000
# Largest one-shot localStorage claim via /api/points/sync.
POINTS_MAX_OFFLINE_CLAIM=50000

# --- Holds -------------------------------------------------------------------
# How long a debit may sit uncommitted before the sweeper returns it. Long enough
# for a caller to finish its own write, short enough that a crashed caller does
# not strand a player's points. The sweeper runs at half this interval.
HOLD_TTL_SECONDS=120
